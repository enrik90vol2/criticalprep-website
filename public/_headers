# Intestazioni HTTP per Cloudflare Pages (GitHub Pages ignora questo file).
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), camera=(), microphone=(), geolocation=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; img-src 'self' data:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/appcast.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=300

/css/*
  Cache-Control: public, max-age=86400
